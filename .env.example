# Copy this file to .env to configure StudyPack locally. .env is git-ignored.
# On Vercel, set the same variables in Project → Settings → Environment Variables.

# ---- AI generation (off by default) ----
# When "true": the frontend shows "Generate study pack", and /api/study-guide
# calls Claude. It's read at build time by the frontend, so redeploy after changing it.
VITE_ENABLE_AI_GENERATION=false

# How the server reaches Claude. If BEDROCK_API_KEY is set, Amazon Bedrock is used;
# otherwise the Claude API with ANTHROPIC_API_KEY.

# Amazon Bedrock: a long-term Bedrock API key, and the region it's used in.
# (Vercel reserves AWS_REGION, so StudyPack uses BEDROCK_REGION.)
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1

# Claude API (alternative): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: model and effort. Defaults: Bedrock global.anthropic.claude-opus-4-6-v1,
# Claude API claude-opus-5; effort high.
# STUDY_GUIDE_MODEL=global.anthropic.claude-opus-4-6-v1
# STUDY_GUIDE_EFFORT=high
# Effort for the short planning step (default low).
# STUDY_GUIDE_PLAN_EFFORT=low

# ---- Google sign-in ----
# Generating with AI needs a Google sign-in, and signed-in students' libraries
# sync across devices. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials, with your site's address
# (and http://localhost, http://localhost:5173 for local dev) under
# "Authorized JavaScript origins". The client id is public; it's read at build
# time by the frontend and by the server, so redeploy after changing it.
VITE_GOOGLE_CLIENT_ID=
# Signs the session cookie. Any long random string; keep it secret. Changing it
# signs everyone out. Required in production (sign-in is refused without it).
SESSION_SECRET=

# ---- Storage (usage, plans, jobs, synced libraries) ----
# Required in production: without these, generation is refused rather than unlimited.
# Adding Upstash in Vercel (Storage → Upstash for Redis) creates them for you.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Plans and usage (see server/plans.js) ----
# Each pack is charged at its real Claude cost, in naira, against two
# allowances: a 3-hour window and a month (Free) or 30-day period (Pro, Max).
# Dollars are converted at this rate; keep it a little above the market rate.
USD_TO_NGN=1600
# Free
FREE_WINDOW_NGN=400
FREE_MONTH_NGN=1000
FREE_MAX_INPUT_CHARS=15000
# Pro and Max: monthly price, then allowances
PRO_PRICE_NGN=3500
PRO_WINDOW_NGN=1000
PRO_MONTH_NGN=2300
MAX_PRICE_NGN=6500
MAX_WINDOW_NGN=2000
MAX_MONTH_NGN=4600
# Longest notes on Pro and Max, in characters (~500 per page).
PAID_MAX_INPUT_CHARS=40000
# Free study packs per day across the whole site, as a budget backstop
# (paid plans aren't counted).
GUIDES_PER_DAY_TOTAL=20

# ---- Payments (Paystack) ----
# Secret key from Paystack → Settings → API Keys & Webhooks. sk_test_… for
# testing (no real money), sk_live_… to take payments. Set the webhook URL there
# to https://<your site>/api/paystack-webhook so card renewals and cancellations
# reach StudyPack. Without a key, the plans page shows "coming soon".
PAYSTACK_SECRET_KEY=
# Where Paystack sends students back after paying (optional; defaults to the
# address they paid from).
# SITE_URL=https://studypack-generator.vercel.app

# Port for the local API server (optional)
# PORT=8787
