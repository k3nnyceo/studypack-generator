# Copy this file to .env to configure StudyPack. .env is git-ignored.

# AI generation (off by default). When "true":
#  - the frontend shows a "Generate with Claude" button, and
#  - the API server's /api/study-guide endpoint calls Claude.
# Restart `npm run dev` after changing it.
VITE_ENABLE_AI_GENERATION=false

# Only needed when AI generation is on. Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Port for the API server (optional)
# PORT=8787
